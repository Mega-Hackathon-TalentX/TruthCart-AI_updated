# TruthCart AI Configuration

PROJECT_NAME=TruthCart AI
TEAM_NAME=TalentX
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Data Directories
OFFICIAL_PRODUCTS_DIR=data/products
OFFICIAL_POLICIES_DIR=data/policies
TEST_QUESTIONS_DIR=data/test_questions
DEV_FIXTURES_DIR=data/development_fixtures

# Model Directories
EMBEDDING_MODEL_DIR=models/embedding_model
INSTRUCTION_MODEL_DIR=models/instruction_model

# Storage & Artifacts
INDEX_DIR=artifacts/indexes
EVALUATION_REPORT_DIR=artifacts/evaluation_reports

# Fixture Mode
# Set to true ONLY during offline development or testing to load synthetic fixtures if official data is empty
LOAD_SYNTHETIC_DEV_DATA_WHEN_EMPTY=false
