# TruthCart AI - Frontend Environment Configuration

# For local development, leave blank to use the Vite proxy (/api -> http://127.0.0.1:8000)
# Or specify an explicit backend URL:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# For production deployment on Vercel pointing to the live Render backend:
# VITE_API_BASE_URL=https://truthcart-ai-updated.onrender.com

